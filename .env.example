# Local development only. Copy to .env and change what you need. Every value is optional.
# The scripts read this file as a shell file, so put quotes around a value that has a space or a $.

# Run two sites at once: give each its own name and ports.
# COMPOSE_PROJECT_NAME=my-site
WP_PORT=8080
MAIL_PORT=8025
# The address WordPress uses for itself. Leave it out to use http://localhost:<WP_PORT>.
# WP_URL=http://localhost:8080

# Versions. Match the site you are copying, and keep the same PHP version in both WordPress tags.
# Set them before the first start: WordPress core is copied into a volume once (see the README).
WORDPRESS_TAG=php8.3-apache
WP_CLI_TAG=cli-php8.3
MARIADB_TAG=11.4
MAILPIT_TAG=v1.33.1

# The theme and the plugin you are building. Point these at another folder to work on code that
# lives in its own repository. The slug is the folder name WordPress sees.
THEME_DIR=./theme
THEME_SLUG=starter-theme
PLUGIN_DIR=./plugin
PLUGIN_SLUG=starter-plugin

# Third-party themes and plugins, and uploads: the folder that holds themes/, plugins/ and uploads/.
WP_CONTENT_DIR=./wp-content

# First install (scripts/setup.sh). Local only: never reuse these anywhere else.
WP_TITLE="Local WordPress"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password
WP_ADMIN_EMAIL=admin@example.test

# Extra plugins from wp-content/plugins to activate in scripts/setup.sh, separated by spaces.
WP_PLUGINS=

# An imported database may use another table prefix.
WP_TABLE_PREFIX=wp_

# PHP memory for a page request. Raise it if a theme or plugin runs out.
WP_MEMORY_LIMIT=256M

# Set to 1 to turn on WP_DEBUG.
WP_DEBUG=

DB_PASSWORD=local-only
